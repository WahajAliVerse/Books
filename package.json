{
  "name": "physical-ai-book-platform",
  "version": "1.0.0",
  "description": "Complete platform for Physical AI & Humanoid Robotics book with interactive features",
  "main": "docusaurus.config.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "backend": "cd backend && node server.js",
    "backend-dev": "cd backend && nodemon server.js",
    "dev": "concurrently \"npm run start\" \"npm run backend-dev\"",
    "ingest": "cd backend && python ingest.py"
  },
  "dependencies": {
    "@docusaurus/core": "^3.0.0",
    "@docusaurus/preset-classic": "^3.0.0",
    "@docusaurus/theme-classic": "^3.0.0",
    "@docusaurus/theme-search-algolia": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "openai": "^4.24.1",
    "chromadb": "^1.5.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.0.0",
    "@docusaurus/tsconfig": "^3.0.0",
    "@docusaurus/types": "^3.0.0",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "keywords": [
    "ai",
    "robotics",
    "physical-ai",
    "humanoid",
    "book",
    "documentation",
    "docusaurus",
    "rag",
    "chatbot"
  ],
  "author": "Physical AI Team",
  "license": "MIT"
}